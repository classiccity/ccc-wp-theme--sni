{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sg-sni/inline-video",
	"title": "Inline Video",
	"description": "Responsive 16:9 video block with poster fallback + caption. Accepts self-hosted MP4 or oEmbed URL (YouTube/Vimeo).",
	"category": "theme",
	"icon": "format-video",
	"keywords": [ "video", "embed", "youtube", "vimeo" ],
	"textdomain": "sg-sni",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"anchor": true,
		"spacing": { "padding": true, "margin": [ "top", "bottom" ] },
		"mode": true
	},
	"acf": {
		"mode": "auto",
		"renderTemplate": "render.php"
	}
}
